# tunnisteen, ja syntyy siihen hakemistoon josta wrangler sattuu ajettavaksi.
.wrangler/

# Datapipeline
__pycache__/
.cache/
# data/ tuotetaan pipelinellä ja julkaistaan CI:stä — ei versionhallintaan,
# jotta repo ei kasva joka ajolla. Sovellukseen bundlattava kopio elää
# hakemistossa assets/data/.
/data/
